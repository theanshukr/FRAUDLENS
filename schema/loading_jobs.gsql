-- ============================================================
-- FraudLens — GSQL Loading Jobs
-- Run after schema is installed.
-- Execute with: python scripts/load_data.py
-- ============================================================

USE GRAPH FraudLens

-- ============================================================
-- DEFINE DATA FILES
-- ============================================================

DEFINE FILENAME f_transactions = "./data/transactions.csv";
DEFINE FILENAME f_identity     = "./data/identity.csv";
DEFINE FILENAME f_closed_cases = "./data/closed_cases_history.csv";
DEFINE FILENAME f_case_pack    = "./data/case_pack.csv";

-- ============================================================
-- LOADING JOB: transactions.csv
-- Loads: Transaction, Card, Customer, EmailDomain, BillingRegion vertices
--        MADE, OWNS, PURCHASER_EMAIL, BILLED_IN edges
-- ============================================================

CREATE LOADING JOB load_transactions FOR GRAPH FraudLens {

    -- Load Transaction vertex
    LOAD f_transactions TO VERTEX Transaction
        VALUES($"TransactionID", to_datetime($"ts"), $"TransactionAmt",
               $"channel", $"ProductCD", $"risk_score", 0, $"dist1", $"dist2", $"P_emaildomain")
        USING header="true", separator=",";

    -- Load Card vertex (card_id = hash of card1-card6)
    LOAD f_transactions TO VERTEX Card
        VALUES(gsql_concat($"card1","_",$"card2","_",$"card3","_",$"card4","_",$"card5","_",$"card6"),
               $"card1", $"card2", $"card3", $"card4", $"card5", $"card6", "", $"card4")
        USING header="true", separator=",";

    -- Load MADE edge (Card → Transaction)
    LOAD f_transactions TO EDGE MADE
        VALUES(gsql_concat($"card1","_",$"card2","_",$"card3","_",$"card4","_",$"card5","_",$"card6"),
               $"TransactionID", to_datetime($"ts"))
        USING header="true", separator=",";

    -- Load Customer vertex
    LOAD f_transactions TO VERTEX Customer
        VALUES($"customer_id", "", "", to_datetime($"ts"), to_datetime($"ts"))
        USING header="true", separator=",";
        
    -- Load OWNS edge (Customer → Card)
    LOAD f_transactions TO EDGE OWNS
        VALUES($"customer_id", gsql_concat($"card1","_",$"card2","_",$"card3","_",$"card4","_",$"card5","_",$"card6"), to_datetime($"ts"))
        USING header="true", separator=",";

    -- Load EmailDomain vertex
    LOAD f_transactions TO VERTEX EmailDomain
        VALUES($"P_emaildomain")
        USING header="true", separator=",";

    -- Load PURCHASER_EMAIL edge
    LOAD f_transactions TO EDGE PURCHASER_EMAIL
        VALUES($"TransactionID", $"P_emaildomain")
        USING header="true", separator=",";

    -- Load BillingRegion vertex
    LOAD f_transactions TO VERTEX BillingRegion
        VALUES($"addr1", $"addr2")
        USING header="true", separator=",";

    -- Load BILLED_IN edge
    LOAD f_transactions TO EDGE BILLED_IN
        VALUES($"TransactionID", $"addr1")
        USING header="true", separator=",";
}

-- ============================================================
-- LOADING JOB: identity.csv
-- Loads: DeviceProfile vertex, FROM_DEVICE edge
-- ============================================================

CREATE LOADING JOB load_identity FOR GRAPH FraudLens {

    -- Load DeviceProfile vertex
    LOAD f_identity TO VERTEX DeviceProfile
        VALUES(gsql_concat($"id_30","_",$"id_31","_",$"id_33"),
               $"DeviceType", $"DeviceInfo", $"id_30", $"id_31", $"id_33", false)
        USING header="true", separator=",";

    -- Load FROM_DEVICE edge (Transaction → DeviceProfile)
    LOAD f_identity TO EDGE FROM_DEVICE
        VALUES($"TransactionID",
               gsql_concat($"id_30","_",$"id_31","_",$"id_33"),
               false)
        USING header="true", separator=",";
}

-- ============================================================
-- LOADING JOB: closed_cases_history.csv
-- Loads: ClosedCase vertex, INVOLVES/ON_CARD edges
-- ============================================================

CREATE LOADING JOB load_closed_cases FOR GRAPH FraudLens {

    LOAD f_closed_cases TO VERTEX ClosedCase
        VALUES($"case_id", $"outcome", $"pattern", $"exposure_usd",
               $"actions_taken", $"analyst_notes",
               to_datetime($"opened_at"), to_datetime($"closed_at"))
        USING header="true", separator=",";
}

-- ============================================================
-- LOADING JOB: case_pack.csv
-- Loads: FraudCase vertex
-- ============================================================

CREATE LOADING JOB load_case_pack FOR GRAPH FraudLens {

    LOAD f_case_pack TO VERTEX FraudCase
        VALUES($"case_id", $"trigger_type", $"trigger_text", $"flagged_txn_id", $"card_id", $"customer_id", $"risk_score", "TRIGGERED", 0.0, 0.0, "", "", "", to_datetime($"opened_at"), to_datetime($"opened_at"), "")
        USING header="true", separator=",";
}
