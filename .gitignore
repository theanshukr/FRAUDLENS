# ============================================================
# FraudLens — .gitignore (Production & Hackathon Grade)
# ============================================================

# --- Secrets & Environment Variables ---
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- All Data & CSV Files (Strictly Ignored) ---
*.csv
**/*.csv
data/
dataset/
dataset_sample/
docs/databasefiles/
*.parquet
*.feather
*.sqlite3
*.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyo

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Node.js & Frontend ---
frontend/node_modules/
node_modules/
frontend/.next/
.next/
out/
frontend/out/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.AppleDouble
.LSOverride

# --- Logs & Runtime Artifacts ---
*.log
logs/
*.log.*

# --- TigerGraph & GSQL Artifacts ---
*.tar.gz

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb
