# ============================================================
# FraudLens — .gitignore
# ============================================================

# --- Secrets & Environment ---
.env
*.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyo

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Data Files (large CSVs — never commit) ---
data/
!data/.gitkeep
docs/databasefiles/

# --- Node / Frontend ---
node_modules/
.next/
out/
dist/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
*.log.*

# --- TigerGraph / GSQL ---
# (Compiled query artifacts)
*.tar.gz

# --- Output / Cases ---
# Uncommit cases/ to track benchmark outputs
# cases/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- OS ---
.DS_Store
.AppleDouble
.LSOverride
Desktop.ini
$RECYCLE.BIN/
