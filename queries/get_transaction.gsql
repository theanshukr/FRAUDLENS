-- ============================================================
-- FraudLens Query: get_transaction
-- Returns full transaction + identity details for a given ID
-- ============================================================

USE GRAPH FraudLens

CREATE OR REPLACE QUERY get_transaction(STRING txn_id) FOR GRAPH FraudLens SYNTAX V1 {
    /*
     * Returns: Transaction vertex attrs + linked Card + DeviceProfile + EmailDomain + BillingRegion
     * Usage: agent calls this as first step of any investigation
     */

    SetAccum<VERTEX> @@results;
    
    start_set = { Transaction.* };
    target_txn = SELECT t FROM start_set:t WHERE t.transaction_id == txn_id
                 ACCUM @@results += t;
    
    cards = { Card.* };
    card = SELECT c FROM cards:c -(MADE:e)-> Transaction:t
           WHERE t.transaction_id == txn_id
           ACCUM @@results += c;
    
    device = SELECT d FROM target_txn:t -(FROM_DEVICE:e)-> DeviceProfile:d
             ACCUM @@results += d;
    
    email = SELECT e FROM target_txn:t -(PURCHASER_EMAIL:e)-> EmailDomain:e
            ACCUM @@results += e;
    
    region = SELECT r FROM target_txn:t -(BILLED_IN:e)-> BillingRegion:r
             ACCUM @@results += r;
    
    PRINT @@results;
}
INSTALL QUERY get_transaction
