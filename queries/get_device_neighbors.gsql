-- ============================================================
-- FraudLens Query: get_device_neighbors
-- Returns all cards and transactions connected to a device profile
-- ============================================================

USE GRAPH FraudLens

CREATE OR REPLACE QUERY get_device_neighbors(STRING profile_id) FOR GRAPH FraudLens SYNTAX V1 {
    OrAccum @is_target_txn;
    SetAccum<VERTEX> @@results;
    
    devs = { DeviceProfile.* };
    target_dev = SELECT d FROM devs:d WHERE d.profile_id == profile_id
                 ACCUM @@results += d;
    
    txns_all = { Transaction.* };
    txns = SELECT t FROM txns_all:t -(FROM_DEVICE:e)-> DeviceProfile:d
           WHERE d.profile_id == profile_id
           ACCUM t.@is_target_txn = true, @@results += t;
    
    cards_all = { Card.* };
    cards = SELECT c FROM cards_all:c -(MADE:e)-> Transaction:t
            WHERE t.@is_target_txn == true
            ACCUM @@results += c;
    
    PRINT @@results;
}
INSTALL QUERY get_device_neighbors
