-- ============================================================
-- FraudLens Query: get_device_neighbors
-- Returns all cards and transactions that used this device profile
-- ============================================================

USE GRAPH FraudLens

CREATE OR REPLACE QUERY get_device_neighbors(STRING device_profile_id) FOR GRAPH FraudLens
SYNTAX V2 {
    /*
     * Returns: All transactions and cards linked to a device profile
     * Key query for identifying shared-device fraud rings
     */

    SetAccum<VERTEX<Card>>        @@cards;
    SetAccum<VERTEX<Transaction>> @@transactions;

    device_v = {DeviceProfile.*};

    -- Transactions that used this device
    txns = SELECT t FROM device_v:d - (FROM_DEVICE:e) - Transaction:t
           WHERE d.profile_id == device_profile_id
           ACCUM @@transactions += t;

    -- Cards that made those transactions
    cards = SELECT c FROM txns:t - (MADE:e) - Card:c
            ACCUM @@cards += c;

    PRINT @@cards, @@transactions;
}
INSTALL QUERY get_device_neighbors
