-- ============================================================
-- FraudLens Query: find_shared_devices
-- Returns all other cards that share a device with this card
-- ============================================================

USE GRAPH FraudLens

CREATE OR REPLACE QUERY find_shared_devices(STRING card_id) FOR GRAPH FraudLens SYNTAX V1 {
    OrAccum @is_shared_device;
    OrAccum @is_other_txn;
    SetAccum<VERTEX> @@devices;
    SetAccum<VERTEX> @@connected_cards;
    
    cards = { Card.* };
    target_card = SELECT c FROM cards:c WHERE c.card_id == card_id;
    
    txns = SELECT t FROM target_card:c -(MADE:e)-> Transaction:t;
    
    devs = SELECT d FROM txns:t -(FROM_DEVICE:e)-> DeviceProfile:d
           ACCUM d.@is_shared_device = true, @@devices += d;
    
    txns_all = { Transaction.* };
    other_txns = SELECT t FROM txns_all:t -(FROM_DEVICE:e)-> DeviceProfile:d
                 WHERE d.@is_shared_device == true
                 ACCUM t.@is_other_txn = true;
    
    cards_all = { Card.* };
    other_cards = SELECT c FROM cards_all:c -(MADE:e)-> Transaction:t
                  WHERE t.@is_other_txn == true AND c.card_id != card_id
                  ACCUM @@connected_cards += c;
    
    PRINT @@devices, @@connected_cards;
}
INSTALL QUERY find_shared_devices
