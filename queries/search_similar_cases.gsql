-- ============================================================
-- FraudLens Query: search_similar_cases
-- GraphRAG: find historically similar fraud cases
-- Enforces strict temporal anti-leakage at the database level:
-- closed_at <= before_ts
-- ============================================================

USE GRAPH FraudLens

CREATE OR REPLACE QUERY search_similar_cases(
    STRING pattern,
    STRING device_profile_id,
    SET<STRING> card_ids,
    STRING before_ts = ""
) FOR GRAPH FraudLens
SYNTAX V2 {
    /*
     * Returns: Closed cases that match by:
     *   1. Same fraud pattern
     *   2. Same device profile (shared device overlap)
     *   3. Same card involved
     * Ranked by number of matching signals.
     * Enforces strict temporal anti-leakage (closed_at <= before_ts).
     */

    SumAccum<INT>   @match_score;

    all_cases = {ClosedCase.*};

    -- 1. Strict Temporal Anti-Leakage Filter
    valid_cases = SELECT cc FROM all_cases:cc
                  WHERE before_ts == "" OR to_datetime(cc.closed_at) <= to_datetime(before_ts);

    -- 2. Match by pattern
    pattern_matches = SELECT cc FROM valid_cases:cc
                      WHERE cc.pattern == pattern
                      ACCUM cc.@match_score += 3;   -- highest weight

    -- 3. Match by shared device (via ON_CARD edge -> card -> device)
    device_matches = SELECT cc FROM valid_cases:cc - (ON_CARD:e) - Card:c
                                                  - (MADE:e2) - Transaction:t
                                                  - (FROM_DEVICE:e3) - DeviceProfile:d
                     WHERE d.profile_id == device_profile_id
                     ACCUM cc.@match_score += 2;

    -- 4. Match by card overlap
    card_matches = SELECT cc FROM valid_cases:cc - (ON_CARD:e) - Card:c
                   WHERE c.card_id IN card_ids
                   ACCUM cc.@match_score += 1;

    -- Return top cases with score > 0
    results = SELECT cc FROM valid_cases:cc
              WHERE cc.@match_score > 0
              ORDER BY cc.@match_score DESC
              LIMIT 5;

    PRINT results;
}
INSTALL QUERY search_similar_cases
