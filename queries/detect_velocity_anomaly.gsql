-- FraudLens Query: detect_velocity_anomaly
USE GRAPH FraudLens
CREATE OR REPLACE QUERY detect_velocity_anomaly(STRING card_id, INT hours) FOR GRAPH FraudLens SYNTAX V2 {
    DATETIME cutoff = datetime_sub(now(), INTERVAL hours HOUR);
    card_v = {Card.*};
    txns = SELECT t FROM card_v:c-(MADE:e)-Transaction:t
           WHERE c.card_id == card_id AND t.ts >= cutoff;
    PRINT txns.size() AS txn_count_in_window;
    PRINT txns;
}
INSTALL QUERY detect_velocity_anomaly
