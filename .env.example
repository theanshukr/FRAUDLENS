# ============================================================
# FraudLens — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ============================================================

# --- TigerGraph Savanna ---
TG_HOST=https://your-workspace.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=your_password_here
TG_GRAPH_NAME=FraudLens
TG_SECRET=your_secret_here
TG_TOKEN=                          # Auto-generated; leave blank initially

# --- TigerGraph MCP ---
TG_MCP_PORT=9000

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini      # Used for non-critical steps to save cost

# --- (Optional) Anthropic / Gemini ---
# ANTHROPIC_API_KEY=sk-ant-your-key
# GOOGLE_API_KEY=your-gemini-key

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FraudLens

# --- Data ---
DATA_DIR=./data
CASES_DIR=./cases

# --- Agent ---
AGENT_MAX_ITERATIONS=5             # Max re-investigation loops before forced stop
AGENT_STOP_PROBABILITY_HIGH=0.85   # Stop if fraud_probability >= this
AGENT_STOP_PROBABILITY_LOW=0.15    # Stop if fraud_probability <= this

# --- Logging ---
LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/fraudlens.log

# --- Development ---
ENV=development                    # development | production
DEBUG=true
